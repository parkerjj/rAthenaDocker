# Compose and image
COMPOSE_PROJECT_NAME=roweb-rathena
RATHENA_IMAGE=roweb/rathena-20211103:local
MARIADB_IMAGE=mariadb:11.4
RATHENA_REF=e985006171d2eb320ee512a653f4c83aea3d81b6

# Must remain aligned with ROWeb v2/lastro-v2-config.js
PACKETVER=20211103
PACKET_OBFUSCATION_KEY1=0x47DA30BB
PACKET_OBFUSCATION_KEY2=0x1B013ABC
PACKET_OBFUSCATION_KEY3=0x234A5224

# Host paths relative to the Compose project directory. Dokploy checks out
# this repository and resolves these paths beside docker-compose.yml.
RATHENA_CONFIG_DIR=./config
RATHENA_LOG_DIR=./log
RATHENA_DB_DATA_DIR=./data/mysql

# MariaDB and rAthena database settings
MARIADB_ROOT_PASSWORD=replace-with-a-long-random-root-password
RATHENA_DB_NAME=ragnarok
RATHENA_DB_USER=ragnarok
RATHENA_DB_PASSWORD=replace-with-a-long-random-database-password
MARIADB_CHARACTER_SET=utf8mb4
MARIADB_COLLATION=utf8mb4_unicode_ci
DB_HEALTHCHECK_INTERVAL=5s
DB_HEALTHCHECK_TIMEOUT=5s
DB_HEALTHCHECK_RETRIES=30
DB_HEALTHCHECK_START_PERIOD=20s

# rAthena runtime settings rendered into config/import/*.txt
RATHENA_NEW_ACCOUNT=yes
RATHENA_USE_MD5_PASSWORDS=no
RATHENA_CLIENT_HASH_CHECK=no
RATHENA_PINCODE_ENABLED=no
RATHENA_PINCODE_FORCE=no
RATHENA_LOGIN_SERVICE_HOST=login
RATHENA_CHAR_SERVICE_HOST=char
RATHENA_LOGIN_PORT=6900
RATHENA_CHAR_PORT=6121
RATHENA_MAP_PORT=5121
RATHENA_CHAR_ADVERTISE_HOST=ro.io-ft.com
RATHENA_MAP_ADVERTISE_HOST=ro.io-ft.com

# Rates are percentages in rAthena: 100 = 1x, so 500000 = 5000x.
RATHENA_BASE_EXP_RATE=500000
RATHENA_JOB_EXP_RATE=500000
RATHENA_MVP_EXP_RATE=500000
RATHENA_QUEST_EXP_RATE=500000
RATHENA_ITEM_RATE_COMMON=500000
RATHENA_ITEM_RATE_COMMON_BOSS=500000
RATHENA_ITEM_RATE_COMMON_MVP=500000
RATHENA_ITEM_RATE_HEAL=500000
RATHENA_ITEM_RATE_HEAL_BOSS=500000
RATHENA_ITEM_RATE_HEAL_MVP=500000
RATHENA_ITEM_RATE_USE=500000
RATHENA_ITEM_RATE_USE_BOSS=500000
RATHENA_ITEM_RATE_USE_MVP=500000
RATHENA_ITEM_RATE_EQUIP=500000
RATHENA_ITEM_RATE_EQUIP_BOSS=500000
RATHENA_ITEM_RATE_EQUIP_MVP=500000
RATHENA_ITEM_RATE_CARD=500000
RATHENA_ITEM_RATE_CARD_BOSS=500000
RATHENA_ITEM_RATE_CARD_MVP=500000
RATHENA_ITEM_RATE_MVP=500000
RATHENA_ITEM_RATE_ADDDROP=500000
RATHENA_ITEM_GROUP_RATE=500000
RATHENA_ITEM_RATE_TREASURE=500000

# Fixed addresses used by the Docker network
BACKEND_SUBNET=172.30.77.0/24
LOGIN_SERVICE_IP=172.30.77.10
CHAR_SERVICE_IP=172.30.77.11
MAP_SERVICE_IP=172.30.77.12

# Public rAthena TCP endpoint and host bindings
RATHENA_BIND_IP=0.0.0.0
RATHENA_LOGIN_BIND_PORT=6900
RATHENA_CHAR_BIND_PORT=6121
RATHENA_MAP_BIND_PORT=5121

# Browser WebSocket to rAthena TCP bridge
# ROWeb connects to wss://ro.io-ft.com/ro.io-ft.com:6900; Nginx should
# proxy that WebSocket location to this service's HTTP port.
RATHENA_SOCKET_PROXY_IMAGE=roweb/rathena-socket-proxy:local
RATHENA_SOCKET_PROXY_VERSION=0.13.0
RATHENA_SOCKET_PROXY_BIND_IP=0.0.0.0
RATHENA_SOCKET_PROXY_LOGIN_LISTEN=0.0.0.0:6901
RATHENA_SOCKET_PROXY_LOGIN_PORT=6901
RATHENA_SOCKET_PROXY_LOGIN_BIND_PORT=6901
RATHENA_SOCKET_PROXY_LOGIN_TARGET_HOST=login
RATHENA_SOCKET_PROXY_LOGIN_TARGET_PORT=6900
RATHENA_SOCKET_PROXY_CHAR_LISTEN=0.0.0.0:6122
RATHENA_SOCKET_PROXY_CHAR_PORT=6122
RATHENA_SOCKET_PROXY_CHAR_BIND_PORT=6122
RATHENA_SOCKET_PROXY_CHAR_TARGET_HOST=char
RATHENA_SOCKET_PROXY_CHAR_TARGET_PORT=6121
RATHENA_SOCKET_PROXY_MAP_LISTEN=0.0.0.0:5122
RATHENA_SOCKET_PROXY_MAP_PORT=5122
RATHENA_SOCKET_PROXY_MAP_BIND_PORT=5122
RATHENA_SOCKET_PROXY_MAP_TARGET_HOST=map
RATHENA_SOCKET_PROXY_MAP_TARGET_PORT=5121

# Permissions for host-rendered configuration files
RATHENA_CONFIG_FILE_MODE=640
RATHENA_CONFIG_DIR_MODE=750
